# test-run artifacts (regenerated by tests/run-*.sh, and written next
# to them — the patterns are deliberately unanchored, so they catch the
# same litter wherever a runner is invoked from)
*.png
*.log
*.err
typed.txt
*-config/

# shim build products (./configure && make). Anchored to the root, so
# Makefile.in stays tracked and a future subdirectory named build/ is
# not swept up by accident.
/Makefile
/config.mk
/build/
/libtkwmx.a
/libtkwmx.so
