#!/bin/sh
# Hand-rolled configure for the tkwmx shim — no autotools by design.
# It builds two things from one source file:
#
#   libtkwmx.a   the static archive a whale (or any statically linked
#                Tcl) swallows whole, registering the package with
#                Tcl_StaticLibrary;
#   libtkwmx.so  the stubs-linked shared build, which ANY Tcl/Tk 9
#                host can `load` — a stock tclkit included. Both are
#                built against the Tcl/Tk STUB libraries only, so the
#                .so carries no undefined Tcl or Tk symbol and does
#                not care whether its host links Tcl statically.
#
# Recognized options:
#   --with-tcl=DIR    directory containing tclConfig.sh
#   --with-tk=DIR     directory containing tkConfig.sh (default: --with-tcl)
#   --host=TRIPLE     cross prefix for cc/ar/ranlib
#   --prefix=DIR      install root (default /usr/local)
#   --libdir=DIR      Tcl package root (default PREFIX/lib)
#   --disable-shared  static archive only (what a kit build wants)
#   --disable-static  shared library only
# Anything else is accepted and ignored, so a caller may pass the usual
# TEA argument set without special-casing this tree.
#
# There is no win64 leg: tkwmx is X11 by nature, and every one of its
# primitives (SubstructureRedirect, reparenting, save-set, the X error
# handler) is an X11 concept with no GDI counterpart.
set -e

TCLDIR=
TKDIR=
HOST=
PREFIX=/usr/local
LIBDIR=
SHARED=yes
STATIC=yes
for arg in "$@"; do
    case $arg in
	--with-tcl=*)     TCLDIR=${arg#--with-tcl=} ;;
	--with-tk=*)      TKDIR=${arg#--with-tk=} ;;
	--host=*)         HOST=${arg#--host=} ;;
	--prefix=*)       PREFIX=${arg#--prefix=} ;;
	--libdir=*)       LIBDIR=${arg#--libdir=} ;;
	--disable-shared) SHARED=no ;;
	--enable-shared)  SHARED=yes ;;
	--disable-static) STATIC=no ;;
	--enable-static)  STATIC=yes ;;
    esac
done

if [ -z "$TCLDIR" ] || [ ! -f "$TCLDIR/tclConfig.sh" ]; then
    echo "configure: tclConfig.sh not found; pass --with-tcl=DIR" >&2
    echo "  (the directory holding tclConfig.sh — /usr/lib on a distro" >&2
    echo "   install, or unix/ in a Tcl build tree. Tk's tkConfig.sh" >&2
    echo "   usually sits next to it; if not, pass --with-tk=DIR too.)" >&2
    exit 1
fi
. "$TCLDIR/tclConfig.sh"

[ -z "$TKDIR" ] && TKDIR=$TCLDIR
if [ ! -f "$TKDIR/tkConfig.sh" ]; then
    echo "configure: tkConfig.sh not found; pass --with-tk=DIR" >&2
    exit 1
fi
. "$TKDIR/tkConfig.sh"

case $HOST in
    *mingw*|*cygwin*|*darwin*)
	echo "configure: tkwmx is X11-only; there is no $HOST build" >&2
	exit 1
	;;
esac
if [ -n "$HOST" ]; then
    CC=${CC:-$HOST-gcc}
    AR=${AR:-$HOST-ar}
    RANLIB=${RANLIB:-$HOST-ranlib}
fi
CC=${CC:-cc}
AR=${AR:-ar}
RANLIB=${RANLIB:-ranlib}
[ -z "$LIBDIR" ] && LIBDIR=$PREFIX/lib

if [ "$SHARED" = no ] && [ "$STATIC" = no ]; then
    echo "configure: --disable-shared and --disable-static leave nothing to build" >&2
    exit 1
fi

mkdir -p build/static build/shared
cp Makefile.in Makefile
cat > config.mk <<EOF
# generated by configure — do not edit
CC = $CC
AR = $AR
RANLIB = $RANLIB
TCL_INCLUDE_SPEC = $TCL_INCLUDE_SPEC
TK_INCLUDE_SPEC = $TK_INCLUDE_SPEC
TCL_STUB_LIB_SPEC = $TCL_STUB_LIB_SPEC
TK_STUB_LIB_SPEC = $TK_STUB_LIB_SPEC
X_CFLAGS = $TK_XINCLUDES
X_LIBS = $TK_XLIBSW -lXrandr -lXinerama
prefix = $PREFIX
libdir = $LIBDIR
BUILD_SHARED = $SHARED
BUILD_STATIC = $STATIC
EOF
echo "configure: wrote config.mk"
echo "  cc      $CC"
echo "  tcl     $TCLDIR"
echo "  tk      $TKDIR"
echo "  build   static=$STATIC shared=$SHARED"
echo "  libdir  $LIBDIR"
