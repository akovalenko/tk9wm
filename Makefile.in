include config.mk

VERSION = 0.1
WMVERSION = 0.1

# Stubs on both legs. The static archive uses them because the whale
# links libtclstub.a anyway; the shared one uses them because that is
# the whole point — a .so with no undefined Tcl/Tk symbol loads into a
# host that links Tcl statically (a tclkit, a whale) just as happily as
# into one with a shared libtcl9.
DEFS = -DUSE_TCL_STUBS -DUSE_TK_STUBS
CFLAGS = -O2 -Wall
CPPFLAGS = $(TCL_INCLUDE_SPEC) $(TK_INCLUDE_SPEC) $(X_CFLAGS) $(DEFS)

SRCS = generic/tkwmx.c
OBJS = build/static/tkwmx.o
POBJS = build/shared/tkwmx.o

STATIC_TARGETS_yes = libtkwmx.a
SHARED_TARGETS_yes = libtkwmx.so
TARGETS = $(STATIC_TARGETS_$(BUILD_STATIC)) $(SHARED_TARGETS_$(BUILD_SHARED))

# Where a `make install` puts each package. Both are plain Tcl package
# directories: drop $(libdir) on TCLLIBPATH (or auto_path) and
# `package require tkwmx` / `package require tk9wm` find them.
SHIMDIR = $(DESTDIR)$(libdir)/tkwmx$(VERSION)
WMDIR = $(DESTDIR)$(libdir)/tk9wm$(WMVERSION)

all: $(TARGETS)

libtkwmx.a: $(OBJS)
	rm -f $@
	$(AR) cr $@ $(OBJS)
	$(RANLIB) $@

libtkwmx.so: $(POBJS)
	$(CC) -shared -o $@ $(POBJS) $(TK_STUB_LIB_SPEC) $(TCL_STUB_LIB_SPEC) $(X_LIBS)

build/static/%.o: generic/%.c
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $<

build/shared/%.o: generic/%.c
	$(CC) $(CFLAGS) $(CPPFLAGS) -fPIC -c -o $@ $<

# The shim alone — for a host that already has the WM's scripts, or
# for putting tkwmx next to treectrl in somebody else's kit.
install-shim: libtkwmx.so
	mkdir -p $(SHIMDIR)
	cp libtkwmx.so $(SHIMDIR)/
	printf '%s\n' \
	    '# generated by tk9wm'"'"'s make install' \
	    'package ifneeded tkwmx $(VERSION) \' \
	    '    [list load [file join $$dir libtkwmx.so] Tkwmx]' \
	    > $(SHIMDIR)/pkgIndex.tcl

# The window manager itself: the library whole — pkgIndex.tcl is the
# manifest of what loads, and the ui host and the .el templates are
# read off the installed tree at run time — plus the entry script
# (installed INTO the package directory, so
# `whale $(libdir)/tk9wm$(WMVERSION)/tk9wm.tcl` runs it). A curated
# file list stood here once and rotted as the library grew; the
# directory cannot fall behind.
install-library:
	mkdir -p $(WMDIR)
	cp -R library/. $(WMDIR)/
	cp tk9wm.tcl $(WMDIR)/

install: install-shim install-library

# The shim's own battery, headless — no window manager required. Any
# Tcl/Tk 9 interpreter will do; point TCLSH at one that can find the
# freshly built shim (the checkout's pkgIndex.tcl does that for you).
TCLSH = wish
test: libtkwmx.so
	TCLLIBPATH=. $(TCLSH) tests/tkwmx/props.tcl
	TCLLIBPATH=. $(TCLSH) tests/tkwmx/events.tcl
	TCLLIBPATH=. $(TCLSH) tests/tkwmx/wm.tcl

clean:
	rm -rf build/static/*.o build/shared/*.o libtkwmx.a libtkwmx.so

distclean: clean
	rm -rf build Makefile config.mk

.PHONY: all install install-shim install-library test clean distclean
